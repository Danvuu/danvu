<Application
    x:Class="Danvu.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="SystemAccentColor">#FA243C</Color>
            <Color x:Key="SystemAccentColorLight1">#FA243C</Color>
            <Color x:Key="SystemAccentColorLight2">#FA243C</Color>
            <Color x:Key="SystemAccentColorLight3">#FA243C</Color>
            <Color x:Key="SystemAccentColorDark1">#FA243C</Color>
            <Color x:Key="SystemAccentColorDark2">#FA243C</Color>
            <Color x:Key="SystemAccentColorDark3">#FA243C</Color>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FA243C" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#FA243C" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FA243C" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#EB243A" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D82034" />
            <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FA243C" />
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable</FontFamily>

            <!-- Keep the native Slider template, keyboard behavior and RangeValue UIA peer. -->
            <x:Double x:Key="SliderTrackThemeHeight">2</x:Double>
            <!-- WinUI 1.8 adds a -2 margin to the thumb Border: 4 + 2 + 2 = 8 visible pixels. -->
            <x:Double x:Key="SliderHorizontalThumbWidth">4</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">4</x:Double>
            <x:Double x:Key="SliderVerticalThumbWidth">4</x:Double>
            <x:Double x:Key="SliderVerticalThumbHeight">4</x:Double>
            <x:Double x:Key="SliderInnerThumbWidth">6</x:Double>
            <x:Double x:Key="SliderInnerThumbHeight">6</x:Double>
            <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#F2F2F5" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" />
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#F2F2F5" />
            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#32FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#42FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#42FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#D9D9DF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="White" />

            <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#F5F5F7" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="#FA243C" />
                <Setter Property="FocusVisualPrimaryThickness" Value="1" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="0.07" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="0.12" />
                                                <Setter Target="Presenter.Opacity" Value="0.82" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border x:Name="Hover" Background="White" Opacity="0"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter x:Name="Presenter" AutomationProperties.AccessibilityView="Raw"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTransitions="{TemplateBinding ContentTransitions}"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
