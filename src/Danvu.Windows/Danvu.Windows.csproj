<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Danvu.Windows</RootNamespace>
    <AssemblyName>Music</AssemblyName>
    <Version>0.1.1-preview.1</Version>
    <Authors>Danvu</Authors>
    <Company>Danvu</Company>
    <Product>Music</Product>
    <Copyright>Copyright © 2026 Danvu</Copyright>
    <ApplicationIcon>Assets/Music.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>Danvu.Windows.Program</StartupObject>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <ProjectReference Include="../Danvu.Core/Danvu.Core.csproj" />
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- WinUI 1.8's generated XBF item list participates in build copying, but the
       .NET publish pipeline uses a different list. Keep the SDK's target paths. -->
  <Target Name="IncludeCompiledXamlInPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="AddProcessedXamlFilesToCopyLocal">
    <ItemGroup>
      <_MusicCompiledXaml Include="@(_ProcessedXamlFilesToCopyLocalWithTargetPath)"
                          Condition="'%(_ProcessedXamlFilesToCopyLocalWithTargetPath.Extension)' == '.xbf'" />
      <_MusicAppXaml Include="@(_MusicCompiledXaml)" Condition="'%(_MusicCompiledXaml.Filename)' == 'App'" />
    </ItemGroup>
    <Error Condition="'@(_MusicAppXaml)' == ''" Text="WinUI did not produce the compiled application XAML publish item." />
    <Error Condition="!Exists('%(_MusicCompiledXaml.FullPath)')" Text="Compiled XAML publish input is missing: %(_MusicCompiledXaml.TargetPath)." />
    <Error Condition="'$(ProjectPriFullPath)' != '' and !Exists('$(ProjectPriFullPath)')" Text="The generated application resource index is missing." />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_MusicCompiledXaml)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(_MusicCompiledXaml.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" Exclude="@(ResolvedFileToPublish)" Condition="'$(ProjectPriFullPath)' != ''">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
